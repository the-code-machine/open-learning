# --- Turso (libSQL) ---
# Production: create a Turso DB, then fill these in (also add them in Vercel).
#   turso db create open-learning
#   turso db show open-learning --url        -> TURSO_DATABASE_URL
#   turso db tokens create open-learning     -> TURSO_AUTH_TOKEN
# Leave blank locally to fall back to a local file (file:local.db) for dev.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Admin (used in Phase 3 for the participation admin page) ---
# A simple shared secret that gates the admin write routes/forms.
ADMIN_SECRET=change-me-to-a-long-random-string
